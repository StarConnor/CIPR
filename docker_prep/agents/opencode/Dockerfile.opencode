FROM base-env

ENV PATH=/node-v22.21.1-linux-x64/bin/:$PATH

COPY opencode.tgz /
USER root
WORKDIR /home/devuser
# Installing the local wrapper tarball lets npm fetch the matching optional
# platform binary packages (opencode-linux-*) during image build.
RUN npm install -g /opencode.tgz --include=optional --no-audit --no-fund \
    && rm /opencode.tgz

USER devuser
RUN mkdir -p /home/devuser/.config/opencode /home/devuser/.local/share/opencode /home/devuser/project \
    && printf '%s\n' '{"$schema":"https://opencode.ai/config.json","permission":{"edit":"allow","bash":"allow","webfetch":"allow"}}' > /home/devuser/.config/opencode/opencode.json

ENV OPENCODE_CONFIG=/home/devuser/.config/opencode/opencode.json
ENV OPENCODE_DISABLE_UPDATE_NOTIFIER=1
ENV OPENCODE_DISABLE_AUTOCOMPACT=1
ENV ENABLE_STRACE=true
ENV LOG_LEVEL=INFO
ENV PYTHONPATH=/app:$PYTHONPATH

USER root
WORKDIR /home/devuser/project

# docker build -t cli-env:opencode -f Dockerfile.opencode .
