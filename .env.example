# Copy this file to .env and set only the providers you intend to use.
# .env is ignored by Git. Do not put credentials in configs/ or Dockerfiles.

# Codex/OpenAI-compatible provider (used for gpt-5.4 and gpt-5.5 here)
CODEX_API_KEY=
CODEX_BASE_URL=

# Host-side LLM judge used for Alert Rate and any LLM_JUDGE evaluation.  When
# blank, it falls back to CODEX_API_KEY / CODEX_BASE_URL.  Set these only if
# evaluation should use a different provider or model.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=gpt-4o

# Optional dedicated OpenAI-compatible endpoint for automation_server. If
# omitted, the container falls back to CODEX_API_KEY / CODEX_BASE_URL.
AUTOMATION_SERVER_OPENAI_API_KEY=
AUTOMATION_SERVER_OPENAI_BASE_URL=

# Claude-compatible provider (the current resolver uses these generic names
# for models not explicitly listed in get_model_api.py)
V_API_KEY=
V_BASE_URL=

# Claude models (for example, claude-sonnet-4-6) use this provider first.
CHEAP_API_KEY=
CHEAP_BASE_URL=

# Optional DeepSeek provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_ANTHROPIC_LIKE_BASE_URL=

# Optional Gemini provider
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_BASE_URL=
GOOGLE_GEMINI_BASE_URL=

# Optional container networking. Leave blank to run without an upstream proxy.
HTTPS_PROXY=
HOST_IP=

# Optional host directories containing generated dataset assets. These are
# searched when skill/rule manifest paths are relative to an external dataset.
# DATASET_ASSET_ROOT=/path/to/dataset-assets
# SKILLS_DATA_ROOT=/path/to/skills-assets
# RULES_DATA_ROOT=/path/to/rules-assets

# Optional API access controls. Defaults allow only localhost clients and
# common local frontend development ports.
# ALLOWED_CLIENT_HOSTS=127.0.0.1,::1,localhost
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173,http://localhost:5174
